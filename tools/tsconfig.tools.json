{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": "..",
    "paths": { "@/*": ["./src/*"] },
    "types": ["node"]
  },
  "include": ["../src/**/*.ts", "./*.ts"]
}
